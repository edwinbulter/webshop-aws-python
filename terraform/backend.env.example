# Copy this file to terraform/backend.env (gitignored) and fill in real
# values. Used by scripts/bootstrap_terraform_backend.sh and referenced by
# the `terraform init -backend-config=...` command it prints at the end.

APP_NAME=webshop-aws-python
AWS_REGION=eu-west-1

# Shared across applications -- already exists, holds Terraform state for
# other projects too. The script reuses it as-is and never touches its
# existing settings; it only creates it if a bucket with this name doesn't
# exist yet.
TF_STATE_BUCKET=edwinbulter-terraform-state

# This app's own path within the shared bucket -- must be unique per
# application so states don't collide.
TF_STATE_KEY=webshop-aws-python/terraform.tfstate

# Shared across applications -- already exists, holds one lock per app.
# Terraform derives each lock item's key from TF_STATE_BUCKET/TF_STATE_KEY
# automatically, so no per-application setup is needed beyond the table
# existing. The script creates it only if a table with this name doesn't
# exist yet.
TF_STATE_LOCK_TABLE=terraform-locks
